{
  "name": "cinder",
  "private": true,
  "version": "0.6.2",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/student",
    "apps/teacher",
    "packages/ui"
  ],
  "scripts": {
    "dev:student": "npm run dev --workspace @cinder/student",
    "dev:teacher": "npm run dev --workspace @cinder/teacher",
    "build:student": "npm run build --workspace @cinder/student",
    "build:teacher": "npm run build --workspace @cinder/teacher",
    "test:gradebook-intent": "node --experimental-strip-types --test scripts/gradebook-intent.test.mjs",
    "bundle:student": "npm run app:build --workspace @cinder/student",
    "bundle:teacher": "npm run app:build --workspace @cinder/teacher",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
