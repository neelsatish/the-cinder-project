{
  "name": "cinder",
  "private": true,
  "version": "0.10.2",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/student",
    "apps/teacher",
    "apps/forge",
    "apps/host",
    "packages/ui"
  ],
  "overrides": {
    "@univerjs/core@0.25.1": {
      "nanoid": "5.1.16"
    }
  },
  "scripts": {
    "dev:student": "npm run dev --workspace @cinder/forge",
    "dev:teacher": "npm run dev --workspace @cinder/teacher",
    "dev:forge": "npm run dev --workspace @cinder/forge",
    "dev:host": "npm run dev --workspace @cinder/host-app",
    "build:student": "npm run build --workspace @cinder/forge",
    "build:teacher": "npm run build --workspace @cinder/teacher",
    "build:forge": "npm run build --workspace @cinder/forge",
    "build:host": "npm run build --workspace @cinder/host-app",
    "test:gradebook-intent": "node --experimental-strip-types --test scripts/gradebook-intent.test.mjs",
    "test:paper-logic": "node --experimental-strip-types --test scripts/paper-logic.test.mjs",
    "test:forge-notes": "node --experimental-strip-types --test scripts/forge-notes.test.mjs",
    "bundle:student": "npm run app:build --workspace @cinder/forge",
    "bundle:teacher": "npm run app:build --workspace @cinder/teacher",
    "bundle:forge": "npm run app:build --workspace @cinder/forge",
    "bundle:host": "npm run app:build --workspace @cinder/host-app",
    "bundle:windows:student": "npm run app:build --workspace @cinder/forge -- --bundles nsis",
    "bundle:windows:teacher": "npm run app:build --workspace @cinder/teacher -- --bundles nsis",
    "bundle:windows:host": "npm run app:build --workspace @cinder/host-app -- --bundles nsis",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
