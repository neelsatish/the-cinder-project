{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the Cinder Student window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-set-app-theme",
    "dialog:allow-open",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "process:allow-restart",
    "updater:default"
  ]
}
